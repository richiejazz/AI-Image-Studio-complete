# Copy to .env and fill in. Never commit .env.

# Cloudinary credentials (Cloudinary Console > Settings > API Keys). Backend only.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Cloudinary folder for uploads (default: ai-image-studio)
CLOUDINARY_FOLDER=ai-image-studio

# Port the API listens on (most hosts set this automatically)
PORT=3000

# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# Processing requests allowed per client IP every 15 minutes (default: 30)
RATE_LIMIT_MAX=30
